# Copy this file to .env. These values are for local development only.
GATEWAY_PORT=3000
AUTH_PORT=3001
PRODUCT_PORT=3002
ORDER_PORT=3003
PAYMENT_PORT=3004

# Use a long random value for your own local project.
JWT_SECRET=replace_this_with_a_long_random_local_secret

# MySQL Server connection (update DB_PASSWORD for your local MySQL user)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=orderflow
DB_CONNECTION_LIMIT=10

# Kafka broker from your existing local Kafka installation
KAFKA_BROKERS=localhost:9092

# Default is a no-money mock checkout so the project works without gateway credentials.
# To use Razorpay Sandbox, set PAYMENT_PROVIDER=razorpay and enter TEST keys below.
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

PRODUCT_SERVICE_URL=http://localhost:3002
ORDER_SERVICE_URL=http://localhost:3003
